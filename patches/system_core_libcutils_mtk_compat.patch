+#ifndef _CUTILS_PMEM_H
+#define _CUTILS_PMEM_H
+
+#include <stddef.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/*
+ * Physically contiguous buffers from /dev/pmem_multimedia, the libcutils
+ * API that MediaTek blobs (libdpframework) link against.
+ */
+
+/* Returns the mapping and its fd in *pfd, or NULL. */
+void* pmem_alloc(size_t size, int *pfd);
+/* Same, uncached (O_SYNC). */
+void* pmem_alloc_sync(size_t size, int *pfd);
+/* Unmaps and closes a buffer from pmem_alloc*. Returns 0 or -1. */
+int pmem_free(void *ptr, size_t size, int fd);
+/* Physical address of the buffer behind fd, or NULL. */
+void* pmem_get_phys(int fd);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* _CUTILS_PMEM_H */
--- /dev/null
+++ b/libcutils/pmem.c
@@ -0,0 +1,88 @@

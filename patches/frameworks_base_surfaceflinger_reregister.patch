@@ -174,6 +174,12 @@
  */
 status_t LayerBuffer::registerBuffers(const ISurface::BufferHeap& buffers)
 {
+#ifdef SURFACEFLINGER_REREGISTER_BUFFERS
+    /* The MediaTek CameraClient registers a new preview heap after
+     * takePicture without unregistering the old one. Refusing it leaves
+     * postBuffer() offsets of the new heap applied to the old one. */
+    unregisterBuffers();

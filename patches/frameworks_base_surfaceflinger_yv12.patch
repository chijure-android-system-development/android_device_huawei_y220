+
+/*
+ * YV12 (Y, then Cr, then Cb; chroma stride is half the luma stride rounded
+ * up to 16) to RGB565, BT.601. GGLSurface keeps only the low byte of the
+ * format, so the GL path cannot take YV12 itself; MediaTek camera services
+ * post their preview this way.
+ */
+static void yv12ToRgb565(const uint8_t* src, int stride, int vstride,
+        int w, int h, uint16_t* dst)
+{
+    const int cstride = ((stride / 2) + 15) & ~15;
+    const uint8_t* yp = src;
+    const uint8_t* vp = src + stride * vstride;
+    const uint8_t* up = vp + cstride * (vstride / 2);
+
+    for (int j = 0; j < h; j++) {
+        const uint8_t* y = yp + j * stride;
+        const uint8_t* v = vp + (j / 2) * cstride;
+        const uint8_t* u = up + (j / 2) * cstride;
+        for (int i = 0; i < w; i++) {
+            int c = 298 * (y[i] - 16);
+            int d = u[i / 2] - 128;
+            int e = v[i / 2] - 128;
+            int r = (c + 409 * e + 128) >> 8;
+            int g = (c - 100 * d - 208 * e + 128) >> 8;
+            int b = (c + 516 * d + 128) >> 8;
+            r = r < 0 ? 0 : (r > 255 ? 255 : r);
+            g = g < 0 ? 0 : (g > 255 ? 255 : g);
+            b = b < 0 ? 0 : (b > 255 ? 255 : b);
+            *dst++ = ((r >> 3) << 11) | ((g >> 2) << 5) | (b >> 3);
+        }
+    }
 }
 

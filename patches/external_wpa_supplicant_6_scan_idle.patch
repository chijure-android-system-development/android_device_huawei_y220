 	for (i = 0; i < wpa_s->scan_res->num; i++) {
+		const u8 *ssid_ie;
+
 		res = wpa_s->scan_res->res[i];
+#ifdef CONFIG_WPA_PRIVATE_LIB
+		ssid_ie = wpa_scan_get_ie(res, WLAN_EID_SSID);
+		if (wpa_private_hide_scan_bss(res->bssid,
+					      ssid_ie ? ssid_ie + 2 : NULL,
+					      ssid_ie ? ssid_ie[1] : 0))
+			continue;
+#else
+		ssid_ie = NULL;
+#endif

+#include "wpa_private.h"
+#endif
 
 static int wpa_supplicant_global_iface_list(struct wpa_global *global,
 					    char *buf, int len);
@@ -814,9 +817,17 @@ static int wpa_supplicant_ctrl_iface_scan_results(
 	int ret;
 	size_t i;
 
+#ifdef CONFIG_WPA_PRIVATE_LIB
+	if (wpa_private_rescan_on_query() || wpa_s->scan_res == NULL) {
+		if (wpa_supplicant_get_scan_results(wpa_s) < 0 &&

 #ifdef ANDROID
 		if (!wpa_s->scanning && ((wpa_s->wpa_state <= WPA_SCANNING) ||
 			(wpa_s->wpa_state >= WPA_COMPLETED))) {
+#endif
+#ifdef CONFIG_WPA_PRIVATE_LIB
+			wpa_private_before_scan(&wpa_s->disconnected);
 #endif
 			wpa_s->scan_req = 2;
 			wpa_supplicant_req_scan(wpa_s, 0, 0);

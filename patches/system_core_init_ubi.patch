@@ -30,8 +30,64 @@
 #include <sys/mount.h>
 #include <sys/resource.h>
 #include <sys/wait.h>
+#include <sys/ioctl.h>
+#include <sys/sysmacros.h>
+#include <stdint.h>
 #include <linux/loop.h>
 
+/* Matches include/mtd/ubi-user.h on the MT6572 3.4 kernel. */
+struct ubi_attach_req {
+    int32_t ubi_num;
+    int32_t mtd_num;
+    int32_t vid_hdr_offset;
+    int8_t padding[12];
+};
+#define UBI_IOCATT _IOW('o', 64, struct ubi_attach_req)
+#define UBI_DEV_NUM_AUTO (-1)
+
+/* Attach an MTD partition. Returns the UBI device number, or -1. */
+static int ubi_attach_mtd(int mtd_num)
+{
+    int ctrl, ret, i, fd;
+    char path[64];
+    char buf[16];
+    struct ubi_attach_req req;
+
+    if (access("/dev/ubi_ctrl", F_OK) < 0)
+        mknod("/dev/ubi_ctrl", S_IFCHR | 0600, makedev(10, 62));
+
+    ctrl = open("/dev/ubi_ctrl", O_RDONLY);
+    if (ctrl < 0)
+        return -1;
+
+    memset(&req, 0, sizeof(req));
+    req.ubi_num = UBI_DEV_NUM_AUTO;
+    req.mtd_num = mtd_num;
+    ret = ioctl(ctrl, UBI_IOCATT, &req);
+    close(ctrl);
+    /*
+     * MTK 3.4 (kernel-c660 cdev.c) writes the new ubi number into
+     * req.ubi_num and returns 0 from the ioctl. Returning ret would
+     * make every volume look like ubi0.
+     */
+    if (ret >= 0)
+        return req.ubi_num >= 0 ? req.ubi_num : ret;
+
+    /* Already attached on this boot. Find the device for this MTD. */
+    for (i = 0; i < 8; i++) {
+        snprintf(path, sizeof(path), "/sys/class/ubi/ubi%d/mtd_num", i);
+        fd = open(path, O_RDONLY);
+        if (fd < 0)
+            continue;
+        memset(buf, 0, sizeof(buf));
+        read(fd, buf, sizeof(buf) - 1);
+        close(fd);
+        if (atoi(buf) == mtd_num)
+            return i;
+    }
+    return -1;
+}
+
 #include "init.h"
 #include "keywords.h"
 #include "property_service.h"

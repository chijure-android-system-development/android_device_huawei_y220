+ * limitations under the License.
+ */
+
+package com.android.bluetooth.opp;
+
+import javax.obex.ResponseCodes;
+
+import android.content.ContentValues;
+import android.content.Context;
+import android.content.Intent;
+import android.net.Uri;
+import android.os.Handler;
+import android.os.Message;
+import android.os.PowerManager;
+import android.os.PowerManager.WakeLock;
+import android.util.Log;
+import android.webkit.MimeTypeMap;
+
+import java.io.File;
+import java.io.IOException;
+
+/**
+ * Inbound session over mtkbt (see BluetoothOppMtk). mtkbt and libextopp do
+ * OBEX and write the file; this asks the user exactly like
+ * BluetoothOppObexServerSession.onPut() and keeps the share in the provider
+ * up to date. One instance lives while the OPP server is enabled.
+ */
+public class BluetoothOppMtkServerSession implements BluetoothOppObexSession,
+        BluetoothOppMtk.Listener {
+    private static final String TAG = "BtOppMtkServer";
+    /* A few lines per transfer; mtkbt problems are hard to see otherwise. */
+    private static final boolean D = true;
+
+    private final Context mContext;
+    private final WakeLock mWakeLock;
+    private Handler mCallback;
+    private BluetoothOppShareInfo mInfo;
+    private BluetoothOppReceiveFileInfo mFileInfo;
+    private boolean mServerBlocking = true;
+    private boolean mTimeoutMsgSent;
+    /* Per connection, like onConnect()/onClose() of the OBEX server. */
+    private long mTimestamp;
+    private int mAccepted = BluetoothShare.USER_CONFIRMATION_PENDING;
+    private boolean mRemoteGone;
+    private boolean mReceiving;
+    private int mPercent;
+
+    public BluetoothOppMtkServerSession(Context context) {
+        mContext = context;
+        PowerManager pm = (PowerManager)context.getSystemService(Context.POWER_SERVICE);
+        mWakeLock = pm.newWakeLock(PowerManager.PARTIAL_WAKE_LOCK, TAG);
+    }
+
+    /* Bluetooth on: mtkbt registers the OPP service and takes pushes. */
+    public void enable() {
+        BluetoothOppMtk.setServerListener(this);
+        if (!BluetoothOppMtk.serverEnableNative()) {
+            Log.e(TAG, "OPP server enable failed");
+        }
+    }
+
+    public void disable() {
+        BluetoothOppMtk.serverDisableNative();
+        BluetoothOppMtk.setServerListener(null);
+    }
+
+    public synchronized void start(Handler handler) {
+        if (D) Log.d(TAG, "Start");
+        mCallback = handler;
+    }
+
+    /* From BluetoothOppTransfer: cancel, or the batch is done. */
+    public void stop() {
+        if (D) Log.d(TAG, "Stop");
+        boolean disconnect;
+        synchronized (this) {
+            disconnect = mReceiving;
+            mCallback = null;
+        }
+        if (disconnect) {
+            BluetoothOppMtk.serverDisconnectNative();
+        }
+    }
+
+    public synchronized void addShare(BluetoothOppShareInfo info) {
+        if (D) Log.d(TAG, "addShare for id " + info.mId);
+        mInfo = info;
+        mFileInfo = BluetoothOppReceiveFileInfo.generateFileInfo(mContext, info.mId);
+        notifyAll();
+    }
+
+    public synchronized void unblock() {
+        mServerBlocking = false;
+        notifyAll();
+    }
+
+    /* Called on the libextopp listen thread. */
+    public void onEvent(int event, String[] params) {
+        if (D) Log.d(TAG, "event " + event);
+        switch (event) {
+            case BluetoothOppMtk.SERVER_ENABLE_SUCCESS:
+            case BluetoothOppMtk.SERVER_ENABLE_FAIL:
+                Log.i(TAG, "OPP server enable " + (event == BluetoothOppMtk.SERVER_ENABLE_SUCCESS));
+                break;
+            case BluetoothOppMtk.SERVER_PUSH_REQUEST:
+                /* Waits for the user; the listen thread must keep running. */
+                final String[] p = params;
+                new Thread("BtOpp MtkServerRequest") {
+                    public void run() {
+                        onPushRequest(p);
+                    }
+                }.start();
+                break;
+            case BluetoothOppMtk.SERVER_PUSH_PROGRESS:
+                onProgress(params);
+                break;
+            case BluetoothOppMtk.SERVER_PUSH_SUCCESS:
+            case BluetoothOppMtk.SERVER_PUSH_FAIL:
+                onPushDone(event == BluetoothOppMtk.SERVER_PUSH_SUCCESS, params);
+                break;
+            case BluetoothOppMtk.SERVER_DISCONNECT:
+                onDisconnect();
+                break;
+        }
+    }
+
+    private void onPushRequest(String[] params) {
+        if (params == null || params.length < 4) {
+            respond(ResponseCodes.OBEX_HTTP_BAD_REQUEST, "0", "");
+            return;
+        }
+        String address = params[0];
+        String name = params[1];
+        String mimeType = params[2];
+        long length;
+        try {
+            length = Long.parseLong(params[3]);
+        } catch (NumberFormatException e) {
+            length = 0;
+        }
+        if (D) Log.d(TAG, "push request " + name + " (" + mimeType + ", " + length
+                + ") from " + address);
+
+        /* The checks of BluetoothOppObexServerSession.onPut(). */
+        int reject = 0;
+        if (length == 0) {
+            reject = ResponseCodes.OBEX_HTTP_LENGTH_REQUIRED;
+        } else if (name == null || name.equals("") || name.lastIndexOf(".") < 0) {
+            reject = ResponseCodes.OBEX_HTTP_BAD_REQUEST;
+        } else {
+            String extension = name.substring(name.lastIndexOf(".") + 1).toLowerCase();
+            String type = MimeTypeMap.getSingleton().getMimeTypeFromExtension(extension);
+            if (type != null) {
+                mimeType = type;
+            }
+            if (mimeType == null || mimeType.equals("")) {
+                reject = ResponseCodes.OBEX_HTTP_UNSUPPORTED_TYPE;
+            } else {
+                mimeType = mimeType.toLowerCase();
+                if (!Constants.mimeTypeMatches(mimeType, Constants.ACCEPTABLE_SHARE_INBOUND_TYPES)
+                        || Constants.mimeTypeMatches(mimeType,
+                                Constants.UNACCEPTABLE_SHARE_INBOUND_TYPES)) {
+                    reject = ResponseCodes.OBEX_HTTP_UNSUPPORTED_TYPE;
+                }
+            }
+        }
+        boolean autoConfirm;
+        synchronized (this) {
+            /* A later object of a connection the user denied. */
+            if (reject == 0 && mAccepted == BluetoothShare.USER_CONFIRMATION_DENIED) {
+                reject = ResponseCodes.OBEX_HTTP_FORBIDDEN;
+            }
+            if (reject != 0) {
+                Log.w(TAG, "reject " + name + ": 0x" + Integer.toHexString(reject));
+                respond(reject, "0", "");
+                return;
+            }
+            if (mTimestamp == 0) {
+                mTimestamp = System.currentTimeMillis();
+            }
+            /* Not the first object, so auto accept it, as onPut() does. */
+            autoConfirm = !mServerBlocking;
+            mInfo = null;
+            mFileInfo = null;
+            mRemoteGone = false;
+            mTimeoutMsgSent = false;
+        }
+
+        ContentValues values = new ContentValues();
+        values.put(BluetoothShare.FILENAME_HINT, name);
+        values.put(BluetoothShare.TOTAL_BYTES, (int)length);
+        values.put(BluetoothShare.MIMETYPE, mimeType);
+        values.put(BluetoothShare.DESTINATION, address);
+        values.put(BluetoothShare.DIRECTION, BluetoothShare.DIRECTION_INBOUND);
+        values.put(BluetoothShare.TIMESTAMP, mTimestamp);
+        if (autoConfirm) {
+            values.put(BluetoothShare.USER_CONFIRMATION,
+                    BluetoothShare.USER_CONFIRMATION_AUTO_CONFIRMED);
+        }
+        Uri contentUri = mContext.getContentResolver().insert(BluetoothShare.CONTENT_URI, values);
+        int id = Integer.parseInt(contentUri.getPathSegments().get(1));
+        if (!autoConfirm) {
+            Intent in = new Intent(BluetoothShare.INCOMING_FILE_CONFIRMATION_REQUEST_ACTION);
+            in.setClassName(Constants.THIS_PACKAGE_NAME, BluetoothOppReceiver.class.getName());
+            mContext.sendBroadcast(in);
+        }
+
+        BluetoothOppShareInfo info;
+        BluetoothOppReceiveFileInfo fileInfo;
+        synchronized (this) {
+            mServerBlocking = true;
+            /* BluetoothOppService starts the transfer, which calls start(),
+             * addShare() and, once the user answers, unblock(). */
+            while ((mServerBlocking || mInfo == null) && !mRemoteGone) {
+                try {
+                    wait(1000);
+                } catch (InterruptedException e) {
+                    break;
+                }
+                if (mCallback != null && !mTimeoutMsgSent) {
+                    mCallback.sendMessageDelayed(mCallback.obtainMessage(
+                            BluetoothOppObexSession.MSG_CONNECT_TIMEOUT),
+                            BluetoothOppObexSession.SESSION_TIMEOUT);
+                    mTimeoutMsgSent = true;
+                }
+            }
+            if (mCallback != null && mTimeoutMsgSent) {
+                mCallback.removeMessages(BluetoothOppObexSession.MSG_CONNECT_TIMEOUT);
+            }
+            info = mInfo;
+            fileInfo = mFileInfo;
+            if (info != null && info.mId != id) {
+                Log.e(TAG, "Unexpected share " + info.mId + ", inserted " + id);
+            }
+            mAccepted = info != null ? info.mConfirm : BluetoothShare.USER_CONFIRMATION_TIMEOUT;
+        }
+        if (D) Log.d(TAG, "after confirm: userAccepted=" + mAccepted
+                + (mRemoteGone ? " (remote gone)" : ""));
+
+        /* generateFileInfo() created the file; libextopp opens it again. */
+        if (fileInfo != null && fileInfo.mOutputStream != null) {
+            try {
+                fileInfo.mOutputStream.close();
+            } catch (IOException e) {
+                // ignore
+            }
+        }
+
+        if (info == null) {
+            /* Remote disconnected before the transfer even started. */
+            Constants.updateShareStatus(mContext, id, BluetoothShare.STATUS_CANCELED);
+            return;
+        }
+        if ((mAccepted == BluetoothShare.USER_CONFIRMATION_CONFIRMED
+                || mAccepted == BluetoothShare.USER_CONFIRMATION_AUTO_CONFIRMED)
+                && !mRemoteGone) {
+            if (fileInfo == null || fileInfo.mFileName == null) {
+                int status = fileInfo != null ? fileInfo.mStatus
+                        : BluetoothShare.STATUS_FILE_ERROR;
+                info.mStatus = status;
+                Constants.updateShareStatus(mContext, info.mId, status);
+                respond(ResponseCodes.OBEX_HTTP_INTERNAL_ERROR, "0", "");
+                sendToTransfer(BluetoothOppObexSession.MSG_SESSION_ERROR, info);
+                return;
+            }
+            Uri shareUri = Uri.parse(BluetoothShare.CONTENT_URI + "/" + info.mId);
+            ContentValues updateValues = new ContentValues();
+            updateValues.put(BluetoothShare._DATA, fileInfo.mFileName);
+            updateValues.put(BluetoothShare.STATUS, BluetoothShare.STATUS_RUNNING);
+            mContext.getContentResolver().update(shareUri, updateValues, null, null);
+            synchronized (this) {
+                mReceiving = true;
+                mPercent = 0;
+            }
+            if (!mWakeLock.isHeld()) {
+                mWakeLock.acquire();
+            }
+            if (D) Log.d(TAG, "accept into " + fileInfo.mFileName);
+            /* Stock passes the total size here; libextopp rejects with 0x60
+             * when it is non-zero and smaller than the object. */
+            respond(0, Long.toString(length), fileInfo.mFileName);
+        } else {
+            Log.i(TAG, "Rejected incoming request");
+            if (fileInfo != null && fileInfo.mFileName != null) {
+                new File(fileInfo.mFileName).delete();
+            }
+            info.mStatus = BluetoothShare.STATUS_CANCELED;
+            Constants.updateShareStatus(mContext, info.mId, BluetoothShare.STATUS_CANCELED);
+            if (!mRemoteGone) {
+                respond(ResponseCodes.OBEX_HTTP_FORBIDDEN, "0", "");
+            }
+            sendToTransfer(BluetoothOppObexSession.MSG_SHARE_INTERRUPTED, info);
+        }
+    }
+
+    private void onProgress(String[] params) {
+        BluetoothOppShareInfo info;
+        synchronized (this) {
+            info = mInfo;
+        }
+        if (info == null || params == null || params.length < 1) {
+            return;
+        }
+        long received;
+        try {
+            received = Long.parseLong(params[0]);
+        } catch (NumberFormatException e) {
+            return;
+        }
+        /* Limit the update() calls to once per percent, as onPut() does. */
+        int percent = info.mTotalBytes > 0 ? (int)(received * 100 / info.mTotalBytes) : 0;
+        synchronized (this) {
+            if (percent <= mPercent && received < info.mTotalBytes) {
+                return;
+            }
+            mPercent = percent;
+        }
+        ContentValues values = new ContentValues();
+        values.put(BluetoothShare.CURRENT_BYTES, received);
+        mContext.getContentResolver().update(
+                Uri.parse(BluetoothShare.CONTENT_URI + "/" + info.mId), values, null, null);
+    }
+
+    private void onPushDone(boolean ok, String[] params) {
+        BluetoothOppShareInfo info;
+        BluetoothOppReceiveFileInfo fileInfo;
+        synchronized (this) {
+            info = mInfo;
+            fileInfo = mFileInfo;
+            mReceiving = false;
+        }
+        if (mWakeLock.isHeld()) {
+            mWakeLock.release();
+        }
+        if (info == null) {
+            return;
+        }
+        int status;
+        if (ok) {
+            status = BluetoothShare.STATUS_SUCCESS;
+            ContentValues values = new ContentValues();
+            values.put(BluetoothShare.CURRENT_BYTES, info.mTotalBytes);
+            mContext.getContentResolver().update(
+                    Uri.parse(BluetoothShare.CONTENT_URI + "/" + info.mId), values, null, null);
+        } else {
+            Log.i(TAG, "Receive failed, code " + (params != null && params.length > 0
+                    ? params[0] : "?"));
+            status = mCallback == null ? BluetoothShare.STATUS_CANCELED
+                    : BluetoothShare.STATUS_OBEX_DATA_ERROR;
+            if (fileInfo != null && fileInfo.mFileName != null) {
+                new File(fileInfo.mFileName).delete();
+            }
+        }
+        if (D) Log.d(TAG, "share " + info.mId + " done, status " + status);
+        info.mStatus = status;
+        Constants.updateShareStatus(mContext, info.mId, status);
+        sendToTransfer(ok ? BluetoothOppObexSession.MSG_SHARE_COMPLETE
+                : BluetoothOppObexSession.MSG_SESSION_ERROR, info);
+    }
+
+    /* The remote closed the connection: onClose() of the OBEX server. */
+    private void onDisconnect() {
+        BluetoothOppShareInfo info;
+        boolean receiving;
+        synchronized (this) {
+            mRemoteGone = true;
+            receiving = mReceiving;
+            mReceiving = false;
+            info = mInfo;
+            mTimestamp = 0;
+            mAccepted = BluetoothShare.USER_CONFIRMATION_PENDING;
+            mServerBlocking = true;
+            notifyAll();
+        }
+        if (mWakeLock.isHeld()) {
+            mWakeLock.release();
+        }
+        if (info == null) {
+            return;
+        }
+        if (receiving) {
+            /* Dropped in the middle of an object. */
+            onPushDoneAfterDisconnect(info);
+        }
+        sendToTransfer(BluetoothOppObexSession.MSG_SESSION_COMPLETE, info);
+    }
+
+    private void onPushDoneAfterDisconnect(BluetoothOppShareInfo info) {
+        BluetoothOppReceiveFileInfo fileInfo;
+        synchronized (this) {
+            fileInfo = mFileInfo;
+        }
+        if (fileInfo != null && fileInfo.mFileName != null) {
+            new File(fileInfo.mFileName).delete();
+        }
+        info.mStatus = BluetoothShare.STATUS_CONNECTION_ERROR;
+        Constants.updateShareStatus(mContext, info.mId, info.mStatus);
+    }
+
+    private void sendToTransfer(int what, BluetoothOppShareInfo info) {
+        Handler callback;
+        synchronized (this) {
+            callback = mCallback;
+        }
+        if (callback == null) {
+            return;
+        }
+        Message msg = Message.obtain(callback, what);
+        msg.obj = info;
+        msg.sendToTarget();
+    }
+
+    /* javax.obex codes carry the final bit; libextopp wants it off (0x43). */
+    private static void respond(int code, String size, String path) {
+        BluetoothOppMtk.serverAccessResponseNative(code & 0x7f, size, path);
+    }
+}

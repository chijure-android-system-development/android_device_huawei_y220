+package com.android.bluetooth.opp;
+
+import android.util.Log;
+
+/**
+ * Object Push through a MediaTek mtkbt stack. Devices without BlueZ RFCOMM
+ * ship libbt_mtk_opp, which drives the vendor OBEX client; elsewhere the
+ * library is absent and isAvailable() is false.
+ */
+final class BluetoothOppMtk {
+    private static final String TAG = "BluetoothOppMtk";
+
+    /* bt_opp_ui_event ids, client group. */
+    static final int ENABLE_SUCCESS = 1;
+    static final int ENABLE_FAIL = 2;
+    static final int CONNECTED = 5;
+    static final int PROGRESS_UPDATE = 6;   // sent bytes, total bytes
+    static final int PUSH_START = 7;        // total bytes
+    static final int PUSH_SUCCESS = 8;
+    static final int PUSH_FAIL = 9;         // OBEX response code
+    static final int DISCONNECT = 16;
+
+    interface Listener {
+        void onEvent(int event, String[] params);
+    }
+
+    private static final boolean sAvailable;
+    private static Listener sListener;
+
+    static {
+        boolean ok = false;
+        try {
+            System.loadLibrary("bt_mtk_opp");
+            ok = true;
+        } catch (UnsatisfiedLinkError e) {
+            // Not an mtkbt device.
+        }
+        sAvailable = ok;
+    }
+
+    private BluetoothOppMtk() {
+    }
+
+    static boolean isAvailable() {
+        return sAvailable;
+    }
+
+    static synchronized void setListener(Listener l) {
+        sListener = l;
+    }
+
+    /* Called from the libextopp listen thread. */
+    private static void onEvent(int event, String[] params) {
+        Listener l;
+        synchronized (BluetoothOppMtk.class) {
+            l = sListener;
+        }
+        if (l != null) {
+            l.onEvent(event, params);
+        } else {
+            Log.w(TAG, "event " + event + " with no session");
+        }
+    }
+
+    static native boolean enableNative();
+    static native boolean connectNative(String address);
+    static native boolean pushNative(String mimeType, String name, String path);
+    static native void abortNative();
+    static native void disconnectNative();
+}
diff --git a/src/com/android/bluetooth/opp/BluetoothOppMtkClientSession.java b/src/com/android/bluetooth/opp/BluetoothOppMtkClientSession.java

@@ -1287,7 +1451,9 @@ static JNINativeMethod sMethods[] = {
     {"cleanupNativeDataNative", "()V", (void *)cleanupNativeDataNative},
     {"startEventLoopNative", "()V", (void *)startEventLoopNative},
     {"stopEventLoopNative", "()V", (void *)stopEventLoopNative},
-    {"isEventLoopRunningNative", "()Z", (void *)isEventLoopRunningNative}
+    {"isEventLoopRunningNative", "()Z", (void *)isEventLoopRunningNative},
+    {"startMtkEventLoopNative", "()V", (void *)startMtkEventLoopNative},
+    {"stopMtkEventLoopNative", "()V", (void *)stopMtkEventLoopNative}
 };
 

+    private void mtkPairingRequest(String address, int variant, int passkey) {
+        address = address.toUpperCase();
+        mPasskeyAgentRequestData.put(address, new Integer(0));
+        if (mBluetoothService.getBondState(address) != BluetoothDevice.BOND_BONDING) {
+            // The other side started it.

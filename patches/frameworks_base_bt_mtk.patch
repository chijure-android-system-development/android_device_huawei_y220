+static void mtk_discovering(JNIEnv *env, bool on)
+{
+    jclass stringClass = env->FindClass("java/lang/String");
+    jobjectArray arr = env->NewObjectArray(2, stringClass, NULL);
+    env->SetObjectArrayElement(arr, 0, env->NewStringUTF("Discovering"));

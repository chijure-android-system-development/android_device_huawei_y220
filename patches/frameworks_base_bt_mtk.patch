+
+/* Object path to address: the path ends in dev_AA_BB_CC_DD_EE_FF. */
+static bool mtk_path_to_addr(JNIEnv *env, jstring path, char addr[18]) {
+    if (path == NULL)
+        return false;
+    const char *c = env->GetStringUTFChars(path, NULL);
+    size_t len = strlen(c);
+    bool ok = len >= 17;
+    if (ok) {
+        strncpy(addr, c + len - 17, 17);
+        addr[17] = 0;
+        for (int i = 0; i < 17; i++)
+            if (addr[i] == '_')
+                addr[i] = ':';
+    }
+    env->ReleaseStringUTFChars(path, c);
+    return ok;
+}
+
+static void *mtk_a2dp_thread(void *) {
+    JNIEnv *env;
+    JavaVMAttachArgs args;
+    char name[] = "BT mtkbt a2dp";
+
+    args.version = JNI_VERSION_1_4;
+    args.name = name;
+    args.group = NULL;
+    mtk_vm->AttachCurrentThread(&env, &args);
+    while (mtk_run) {
+        char addr[18];
+        int state = btmtk_a2dp_event_wait(addr, 500);
+        if (state < 0) {
+            usleep(200000);
+            continue;
+        }
+        if (state == BTMTK_A2DP_NONE)
+            continue;

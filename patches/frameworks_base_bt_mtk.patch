+static jboolean mtkSetAdapterProperty(const char *key, void *value, int type) {
+    if (!strcmp(key, "Name") && type == DBUS_TYPE_STRING) {
+        const char *name = *(const char **)value;
+        if (btmtk_gap_set_local_name(name) != 0)
+            return JNI_FALSE;
+        strncpy(s_mtk_name, name, sizeof(s_mtk_name) - 1);
+        s_mtk_name[sizeof(s_mtk_name) - 1] = 0;
+        return JNI_TRUE;
+    }
+    if ((!strcmp(key, "Pairable") || !strcmp(key, "Discoverable")) &&
+            type == DBUS_TYPE_BOOLEAN) {
+        int bit = !strcmp(key, "Pairable") ? BTMTK_GAP_SCAN_PAGE : BTMTK_GAP_SCAN_INQUIRY;
+        int mode = *(int *)value ? (s_mtk_scan_mode | bit) : (s_mtk_scan_mode & ~bit);

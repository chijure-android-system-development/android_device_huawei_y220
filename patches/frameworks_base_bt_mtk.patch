+            return JNI_FALSE;
+        s_mtk_scan_mode = mode;
+        return JNI_TRUE;
+    }
+    if (!strcmp(key, "DiscoverableTimeout") && type == DBUS_TYPE_UINT32) {
+        /* mtkbt has no timer for this; BluetoothService ends the window. */
+        snprintf(s_mtk_discoverable_timeout, sizeof(s_mtk_discoverable_timeout),
+                 "%u", *(unsigned int *)value);
+        return JNI_TRUE;
+    }
+    return JNI_FALSE;

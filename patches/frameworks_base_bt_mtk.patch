+
+#ifdef HAVE_BLUETOOTH_MTK
+/*
+ * mtkbt: the A2DP source runs in the vendor stack and libbt_mtk_a2dp drives
+ * it like the stock MTK framework. State changes come from mtkbt as
+ * indications and go to Java as BlueZ AudioSink "State" changes.
+ */
+static JavaVM *mtk_vm;
+static jobject mtk_obj;
+static jmethodID method_onMtkSinkStateChanged;
+static pthread_mutex_t mtk_lock = PTHREAD_MUTEX_INITIALIZER;
+static pthread_t mtk_thread;

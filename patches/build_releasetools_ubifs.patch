--- a/tools/releasetools/edify_generator.py
+++ b/tools/releasetools/edify_generator.py
@@ -153,6 +153,18 @@ class EdifyGenerator(object):
     fstab = self.info.get("fstab", None)
     if fstab:
       p = fstab[mount_point]
+      if p.fs_type == "ubifs":
+        # The Gingerbread updater mounts anything that is not "MTD" with
+        # the mount() syscall. TWRP already has the ubi device node.
+        self.script.append('unmount("%s");' % (p.mount_point,))
+        self.script.append('assert(mount("ubifs", "UBI", "%s", "%s"));' %
+                           (p.device, p.mount_point))
+        if p.mount_point == "/system":
+          self.script.append('package_extract_file("system/bin/y220-wipe-system.sh", "/tmp/y220-wipe-system.sh");')
+          self.script.append('set_perm(0, 0, 0755, "/tmp/y220-wipe-system.sh");')
+          self.script.append('assert(run_program("/tmp/y220-wipe-system.sh") == "0");')
+        self.mounts.add(p.mount_point)
+        return
       self.script.append('mount("%s", "%s", "%s", "%s");' %
                          (p.fs_type, common.PARTITION_TYPES[p.fs_type],
                           p.device, p.mount_point))
@@ -181,6 +193,10 @@ class EdifyGenerator(object):
     fstab = self.info.get("fstab", None)
     if fstab:
       p = fstab[partition]
+      if p.fs_type == "ubifs":
+        self.script.append('ui_print("Keeping the existing UBIFS volume %s");' %
+                           (partition,))
+        return
       self.script.append('format("%s", "%s", "%s");' %
                          (p.fs_type, common.PARTITION_TYPES[p.fs_type], p.device))
 
@@ -226,10 +242,19 @@ class EdifyGenerator(object):
       partition_type = common.PARTITION_TYPES[p.fs_type]
       args = {'device': p.device, 'fn': fn}
       if partition_type == "MTD":
-        self.script.append(
-            ('assert(package_extract_file("%(fn)s", "/tmp/%(device)s.img"),\n'
-             '       write_raw_image("/tmp/%(device)s.img", "%(device)s"),\n'
-             '       delete("/tmp/%(device)s.img"));') % args)
+        if (self.info.get("mtk_bootimg") == "1" and
+            mount_point == "/boot"):
+          # TWRP's flash_image erases the NAND partition and writes the
+          # MTK-headed image. The Gingerbread write_raw_image path does not.
+          self.script.append(
+              ('assert(package_extract_file("%(fn)s", "/tmp/boot.img"),\n'
+               '       run_program("/sbin/flash_image", "boot", "/tmp/boot.img") == "0",\n'
+               '       delete("/tmp/boot.img"));') % args)
+        else:
+          self.script.append(
+              ('assert(package_extract_file("%(fn)s", "/tmp/%(device)s.img"),\n'
+               '       write_raw_image("/tmp/%(device)s.img", "%(device)s"),\n'
+               '       delete("/tmp/%(device)s.img"));') % args)
       elif partition_type == "EMMC":
         self.script.append(
             'package_extract_file("%(fn)s", "%(device)s");' % args)

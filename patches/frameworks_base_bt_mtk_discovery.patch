+#ifdef HAVE_BLUETOOTH_MTK
+#include "bt_mtk_gap.h"
+
+/*
+ * mtkbt (MediaTek stack) is the radio, not BlueZ. Its indications arrive on
+ * bt.ext.adp; turn them into the calls BluetoothEventLoop gets from the
+ * BlueZ D-Bus loop, so Settings sees ACTION_FOUND and DISCOVERY_*.
+ */
+static JavaVM *s_mtk_vm;
+static jobject s_mtk_obj;
+static pthread_t s_mtk_thread;
+static volatile int s_mtk_run;
+
+static void mtk_discovering(JNIEnv *env, bool on)
+{
+    jclass stringClass = env->FindClass("java/lang/String");
+    jobjectArray arr = env->NewObjectArray(2, stringClass, NULL);
+    env->SetObjectArrayElement(arr, 0, env->NewStringUTF("Discovering"));
+    env->SetObjectArrayElement(arr, 1, env->NewStringUTF(on ? "true" : "false"));
+    env->CallVoidMethod(s_mtk_obj, method_onPropertyChanged, arr);
+    env->DeleteLocalRef(arr);
+    env->DeleteLocalRef(stringClass);
+}
+
+static void mtk_device_found(JNIEnv *env, const btmtk_gap_event_t *ev)
+{
+    char cod[16], rssi[16];
+    const char *kv[16];
+    int n = 0;
+
+    snprintf(cod, sizeof(cod), "%u", ev->cod);
+    snprintf(rssi, sizeof(rssi), "%d", ev->rssi);
+    kv[n++] = "Address"; kv[n++] = ev->addr;
+    kv[n++] = "Class";   kv[n++] = cod;
+    kv[n++] = "RSSI";    kv[n++] = rssi;
+    kv[n++] = "Paired";  kv[n++] = "false";
+    if (ev->name[0]) {
+        kv[n++] = "Name";  kv[n++] = ev->name;
+        kv[n++] = "Alias"; kv[n++] = ev->name;
+    }
+
+    jclass stringClass = env->FindClass("java/lang/String");
+    jobjectArray arr = env->NewObjectArray(n, stringClass, NULL);
+    for (int i = 0; i < n; i++) {
+        jstring s = env->NewStringUTF(kv[i]);
+        env->SetObjectArrayElement(arr, i, s);
+        env->DeleteLocalRef(s);
+    }
+    jstring addr = env->NewStringUTF(ev->addr);
+    env->CallVoidMethod(s_mtk_obj, method_onDeviceFound, addr, arr);
+    env->DeleteLocalRef(addr);
+    env->DeleteLocalRef(arr);
+    env->DeleteLocalRef(stringClass);
+}
+
+static void *mtk_event_thread(void *)
+{
+    JNIEnv *env;
+    JavaVMAttachArgs args;
+    char name[] = "BT mtkbt events";
+
+    args.version = JNI_VERSION_1_4;
+    args.name = name;
+    args.group = NULL;
+    s_mtk_vm->AttachCurrentThread(&env, &args);
+
+    while (s_mtk_run) {
+        btmtk_gap_event_t ev;
+        if (btmtk_gap_event_wait(&ev, 500) <= 0)
+            continue;
+        switch (ev.type) {
+        case BTMTK_GAP_EV_DISCOVERY_STARTED:
+            mtk_discovering(env, true);
+            break;
+        case BTMTK_GAP_EV_DISCOVERY_FINISHED:
+            mtk_discovering(env, false);
+            break;
+        case BTMTK_GAP_EV_DEVICE_FOUND:
+            mtk_device_found(env, &ev);
+            break;
+        }
+        if (env->ExceptionCheck()) {
+            LOGE("exception in mtkbt event handler");
+            env->ExceptionDescribe();
+            env->ExceptionClear();
+        }
+    }
+
+    s_mtk_vm->DetachCurrentThread();
+    return NULL;
+}
+
+static void startMtkEventLoopNative(JNIEnv *env, jobject object)
+{
+    if (s_mtk_run)
+        return;
+    if (btmtk_gap_events_open() != 0)
+        return;
+    env->GetJavaVM(&s_mtk_vm);
+    s_mtk_obj = env->NewGlobalRef(object);
+    s_mtk_run = 1;
+    if (pthread_create(&s_mtk_thread, NULL, mtk_event_thread, NULL) != 0) {
+        LOGE("cannot start the mtkbt event thread");
+        s_mtk_run = 0;
+        env->DeleteGlobalRef(s_mtk_obj);
+        s_mtk_obj = NULL;
+        btmtk_gap_events_close();
+    }
+}
+
+static void stopMtkEventLoopNative(JNIEnv *env, jobject object)
+{
+    if (!s_mtk_run)
+        return;
+    s_mtk_run = 0;
+    pthread_join(s_mtk_thread, NULL);
+    btmtk_gap_events_close();
+    env->DeleteGlobalRef(s_mtk_obj);
+    s_mtk_obj = NULL;
+}
+#else
+static void startMtkEventLoopNative(JNIEnv *env, jobject object) {}
+static void stopMtkEventLoopNative(JNIEnv *env, jobject object) {}
+#endif

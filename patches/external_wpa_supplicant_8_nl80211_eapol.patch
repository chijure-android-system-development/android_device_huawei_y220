diff --git a/src/drivers/driver_nl80211.c b/src/drivers/driver_nl80211.c
index 7fb51fc..4d5ab76 100644
--- a/src/drivers/driver_nl80211.c
+++ b/src/drivers/driver_nl80211.c
@@ -4441,6 +4441,30 @@ static int wpa_driver_nl80211_hapd_send_eapol(
 	int res;
 	int qos = flags & WPA_STA_WMM;
 
+	if (drv->monitor_sock < 0 && drv->eapol_sock >= 0) {
+		/*
+		 * No monitor interface (full-MAC driver that refuses one, like
+		 * the MTK wlan_mt6582 ap0): send the EAPOL frame as Ethernet
+		 * on the AP interface; the driver adds the 802.11 header.
+		 */
+		struct sockaddr_ll ll;
+
+		os_memset(&ll, 0, sizeof(ll));
+		ll.sll_family = AF_PACKET;
+		ll.sll_ifindex = if_nametoindex(bss->ifname);
+		ll.sll_protocol = htons(ETH_P_PAE);
+		ll.sll_halen = ETH_ALEN;
+		os_memcpy(ll.sll_addr, addr, ETH_ALEN);
+		res = sendto(drv->eapol_sock, data, data_len, 0,
+			     (struct sockaddr *) &ll, sizeof(ll));
+		if (res < 0) {
+			wpa_printf(MSG_ERROR, "nl80211: EAPOL sendto: %s",
+				   strerror(errno));
+			return -1;
+		}
+		return 0;
+	}
+
 	len = sizeof(*hdr) + (qos ? 2 : 0) + sizeof(rfc1042_header) + 2 +
 		data_len;
 	hdr = os_zalloc(len);

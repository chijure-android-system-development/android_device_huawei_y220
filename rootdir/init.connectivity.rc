# MT6572 combo (WMT): Wi-Fi, Bluetooth, FM and GPS share one connectivity
# subsystem. The modules come from the Y220 kernel (kernel-modules.mk);
# 6620_launcher loads the combo patch and keeps WMT running.

on post-fs-data
    insmod /system/lib/modules/mtk_stp_wmt.ko
    insmod /system/lib/modules/mtk_stp_bt.ko
    insmod /system/lib/modules/mtk_stp_gps.ko
    insmod /system/lib/modules/mtk_fm_drv.ko
    insmod /system/lib/modules/mtk_wmt_wifi.ko
    insmod /system/lib/modules/cfg80211.ko

    # This file is imported last, so every MTK module is loaded by now.
    # CM's init has no mknod; the script makes the driver nodes.
    exec /system/bin/sh /system/etc/init.mtk-nodes.sh

    chmod 0660 /dev/ttyMT2
    chown system system /dev/ttyMT2

    mkdir /data/misc/wifi 0770 wifi wifi
    mkdir /data/misc/wifi/sockets 0770 wifi wifi
    mkdir /data/misc/dhcp 0770 dhcp dhcp
    chown dhcp dhcp /data/misc/dhcp

service conn_launcher /system/bin/6620_launcher -m 3 -p /system/etc/firmware/
    class core
    user system
    group system

# WIFI_FIRMWARE_LOADER: started by the Wi-Fi HAL after it insmods
# wlan_mt6582.ko. Powers on WMT Wi-Fi and reports wlan.driver.status.
service wmt_wifi_loader /system/bin/sh /system/etc/wifi/wmt-wifi-on.sh
    user root
    disabled
    oneshot

service p2p_supplicant /system/bin/wpa_supplicant \
    -iwlan0 -Dnl80211 -c/data/misc/wifi/wpa_supplicant.conf -N \
    -ip2p0 -Dnl80211 -c/data/misc/wifi/p2p_supplicant.conf -e/data/misc/wifi/entropy.bin -puse_p2p_group_interface=1
    class main
    socket wpa_wlan0 dgram 660 wifi wifi
    disabled
    oneshot

service wpa_supplicant /system/bin/wpa_supplicant \
    -iwlan0 -Dnl80211 -c/data/misc/wifi/wpa_supplicant.conf -e/data/misc/wifi/entropy.bin
    class main
    socket wpa_wlan0 dgram 660 wifi wifi
    disabled
    oneshot

service dhcpcd_wlan0 /system/bin/dhcpcd -aABDKL
    class main
    disabled
    oneshot

service dhcpcd_p2p /system/bin/dhcpcd -aABKL
    class main
    disabled
    oneshot

service iprenew_wlan0 /system/bin/dhcpcd -n
    class main
    disabled
    oneshot

service iprenew_p2p /system/bin/dhcpcd -n
    class main
    disabled
    oneshot

service dhcpcd_bt-pan /system/bin/dhcpcd -ABKL
    class main
    disabled
    oneshot

service iprenew_bt-pan /system/bin/dhcpcd -n
    class main
    disabled
    oneshot

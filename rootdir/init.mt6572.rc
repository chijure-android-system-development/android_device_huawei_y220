# Huawei Y220-U05 (MT6572). Imported by init.rc as /init.${ro.hardware}.rc.

import /init.mt6572.usb.rc
import /init.modem.rc
import /init.connectivity.rc

on init
    # Symbols the stock MTK blobs take from MTK's own liblog, libmedia,
    # libui and libcamera_client (device/huawei/y220/libmtk_symbols).
    export LD_PRELOAD libmtk_symbols.so

    # 4.2 storage: the microSD is the primary external volume.
    mkdir /storage/sdcard0 0000 system system
    export EXTERNAL_STORAGE /storage/sdcard0
    symlink /storage/sdcard0 /sdcard
    symlink /storage/sdcard0 /mnt/sdcard

    # MTK NVRAM backup partitions (stock init.protect.rc).
    mkdir /protect_f 0771 system system
    mkdir /protect_s 0771 system system

on fs
    # system, userdata and cache are UBIFS on NAND. ubiattach_y220 attaches
    # them as ubi0, ubi1 and ubi2 (the numbering in TWRP's fstab).
    exec /sbin/ubiattach_y220
    mount ubifs /dev/ubi0_0 /system ro wait
    mount ubifs /dev/ubi1_0 /data nosuid nodev wait
    mount ubifs /dev/ubi2_0 /cache nosuid nodev wait

    mount yaffs2 mtd@protect_f /protect_f nosuid nodev
    mount yaffs2 mtd@protect_s /protect_s nosuid nodev
    chown system system /protect_f
    chmod 0771 /protect_f
    chown system system /protect_s
    chmod 0771 /protect_s

on post-fs-data
    mkdir /data/media 0770 media_rw media_rw

    # Display and sync nodes, as stock.
    chmod 0660 /dev/graphics/fb0
    chown system graphics /dev/graphics/fb0
    chmod 0660 /dev/mtkfb_vsync
    chown system graphics /dev/mtkfb_vsync
    chmod 0660 /dev/sw_sync
    chown system graphics /dev/sw_sync

    # Backlight: LightsService runs in system_server.
    chown system system /sys/class/leds/lcd-backlight/brightness

    # Device node owners are in ueventd.mt6572.rc.
    mkdir /data/misc/sensors 0664 system system

    # Headset hook and call state, as stock.
    chown root radio /sys/devices/platform/Accdet_Driver/driver/accdet_call_state
    chown radio radio /sys/devices/platform/mtk-kpd/driver/kpd_call_state
    chown radio radio /sys/devices/platform/battery/Charging_CallState

    # Video codec driver (stock init.rc); /dev/Vcodec is made by
    # init.mtk-nodes.sh.
    insmod /system/lib/modules/vcodec_kernel_driver.ko

    setprop vold.post_fs_data_done 1

on boot
    # zram swap is set up by CM's compcache service (ro.zram.default in
    # system.prop).

    # lowmemorykiller levels are left to ActivityManager (4.2 writes them).

    # Thermal policy (/etc/.tp) and the kernel shutdown request.
    start thermal_manager
    start thermald
    start pq

service thermal_manager /system/bin/thermal_manager
    class main
    user root
    disabled
    oneshot

service thermald /system/bin/thermald
    class main
    user root
    disabled

# Display picture quality tables (MDP).
service pq /system/bin/pq
    class main
    user root
    disabled
    oneshot

# Power-off charging. The LK boots this image with boot_reason=1 when the
# phone is off and a charger is plugged in; BOARD_CHARGING_CMDLINE_* make
# init mount the filesystems and run "charger" instead of "boot", so the
# modem and Android stay off. The stock ipod draws the Huawei charging
# animation from the logo partition, reboots into Android on a long power
# key press and asks for "shutdown" when the charger is unplugged.
service ipod /system/bin/logwrapper /system/bin/ipod
    class charger
    user root
    group root

service shutdown /system/bin/reboot -p
    disabled
    oneshot

#!/system/bin/sh
# Modem setup from stock init.rc and init.modem.rc (post-fs-data).
# Runs before class_start, so ccci_fsd and ccci_mdinit find all of this.
MOD=/system/lib/modules
insmod $MOD/sec.ko
[ -c /dev/sec ] || mknod /dev/sec c 182 0
chown root:system /dev/sec
chmod 660 /dev/sec
insmod $MOD/devapc.ko
# ccci_mdinit opens /dev/devmap.
insmod $MOD/devinfo.ko
[ -c /dev/devmap ] || mknod /dev/devmap c 196 0
chown root:media /dev/devmap
chmod 444 /dev/devmap
# 9996 is ccci, 9997 is nvram.
mkdir -p /data/nvram/md
chown root:9997 /data/nvram /data/nvram/md
chmod 770 /data/nvram /data/nvram/md
insmod $MOD/ccci_plat.ko
insmod $MOD/ccci.ko
chown 9996:9996 /sys/kernel/ccci/boot
# CM7 ueventd takes only names in ueventd.rc and has none for ccci or
# nvram, so set the stock owners here once ueventd has made the nodes.
i=0
while [ ! -c /dev/ttyC0 ] && [ $i -lt 30 ]; do sleep 0.1; i=$((i+1)); done
chown 9996:9996 /dev/ccci* /dev/ttyC*
chmod 660 /dev/ccci* /dev/ttyC*
if [ -c /dev/otp ]; then
    chown root:9997 /dev/otp
    chmod 660 /dev/otp
fi
# gsm0710muxd puts the pttys for mtk-ril.so here.
mkdir -p /dev/radio
chown radio:radio /dev/radio
chmod 770 /dev/radio

<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- USB tethering. The android_usb gadget names the RNDIS link rndis0;
         netd switches android0/functions to rndis,adb while it is on. -->
    <string-array name="config_tether_usb_regexs" translatable="false">
        <item>"rndis\\d"</item>
    </string-array>

    <!-- Hotspot. wlan_mt6582 names its AP interface ap0. -->
    <string-array name="config_tether_wifi_regexs" translatable="false">
        <item>"ap\\d"</item>
    </string-array>
</resources>

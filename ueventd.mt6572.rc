# Sensor nodes, from stock init.rc. The sensors HAL runs in system_server.
# CM7 ueventd only takes names here, so ccci/nvram owners are in init.d/06modem.
/dev/hwmsensor            0660   system     system
/dev/gsensor              0660   system     system
/dev/msensor              0660   system     system
/dev/alsps                0660   system     system

# Camera nodes, from stock init.rc. Stock mediaserver runs as root; here it
# is media with the camera group (not media), so camera owns SMI and MDP.
/dev/camera-sysram        0664   system     camera
/dev/camera-isp           0664   system     camera
/dev/camera-pipemgr       0664   system     camera
/dev/kd_camera_hw         0660   system     camera
/dev/kd_camera_hw_bus2    0660   system     camera
/dev/kd_camera_flashlight 0660   system     camera
/dev/FM50AF               0660   system     camera
/dev/CAM_CAL_DRV          0660   system     camera
/dev/MTK_SMI              0660   system     camera
/dev/mt-mdp               0660   system     camera
/dev/M4U_device           0444   root       root
/dev/mtk_disp             0444   root       root
/dev/mtk_jpeg             0444   root       root

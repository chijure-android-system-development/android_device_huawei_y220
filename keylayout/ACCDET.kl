# Headset buttons (ACCDET input device), as stock /system/usr/keylayout/ACCDET.kl.
# Without this file EventHub uses qwerty.kl and drops 163-166 and 122.
key 231   CALL
key 122   ENDCALL           WAKE
key 166   MEDIA_STOP
key 163   MEDIA_NEXT
key 164   MEDIA_PLAY_PAUSE
key 165   MEDIA_PREVIOUS
key 114   VOLUME_DOWN
key 115   VOLUME_UP
